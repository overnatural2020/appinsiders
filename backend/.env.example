# --- SEC EDGAR (obligatorio) ---
SEC_USER_AGENT="appInsiders tu-email@dominio.com"
SEC_MIN_INTERVAL_MS=130     # ~7.7 req/s (límite SEC: 10/s)

# --- Auth ---
JWT_SECRET="pon-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="admin@overnatural.com"
ADMIN_PASSWORD="cambia-esto"

# --- Correo (Resend). Sin RESEND_API_KEY -> modo simulado (log) ---
RESEND_API_KEY=""
EMAIL_FROM="Insider Alerts <alertas@overnatural.com>"
APP_URL="https://overnatural.com"

# --- Datos / runtime ---
DATA_DIR="/data"           # en Railway: punto de montaje del Volume
PORT="8080"                # Railway inyecta su propio PORT
RUN_SCHEDULER="true"       # scheduler embebido en el server
INSPECT_CRON="0 7 * * 1"   # lunes 07:00 UTC

# --- Ingesta inicial automática (solo si el store está vacío) ---
SEED_TICKERS="AMBA,CRDO,ALAB,TER,INTC"
SEED_SINCE="2024-12-01"
